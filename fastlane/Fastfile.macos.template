# Fastfile (macOS)
# https://docs.fastlane.tools/
#
# 標準 lane 一覧:
#   fastlane mac metadata             -- メタデータのみ（スクショなし）
#   fastlane mac screenshots          -- スクリーンショットのみ
#   fastlane mac upload_metadata      -- メタデータ + スクリーンショット
#   fastlane mac upload_build         -- ビルドのみ（審査提出なし）
#   fastlane mac upload_all           -- メタデータ + スクショ + ビルド
#   fastlane mac submit               -- 審査に提出
#   fastlane mac availability_show    -- 配信対象 territory を ASC から取得して表示
#   fastlane mac availability_apply   -- fastlane/available_territories.json から ASC に反映
#
# メタデータの実体は releases/current/metadata/<locale>/ (共有レイアウト。説明文・キーワード等)、
# リリースノートは releases/v$(MARKETING_VERSION)/release_notes/<locale>.txt にある。
# releases/current/metadata が無い app は旧来どおり releases/v$(MARKETING_VERSION)/metadata/
# を使う (release_metadata_path のコメント参照)。スクリーンショットは
# releases/v$(MARKETING_VERSION)/screenshots/。fastlane/metadata, fastlane/screenshots は使わない。
#
# 配信対象 territory（app-level、version 非依存）は fastlane/available_territories.json
# が単一マスター。Web 上で territory を変更したら available_territories.json を
# 更新して push し直すのが正規ルート（version-specific ではないため
# releases/v$(MARKETING_VERSION)/ には置かない）。

require 'json'
require 'base64'

default_platform(:mac)

# deliver 等の action に渡すパスは **必ず絶対パス** にすること。
#
# fastlane は「lane 本体の評価時 (cwd = fastlane/)」と「action の実行時 (cwd = プロジェクトルート)」で
# cwd が変わる (Fastlane::Runner が両方で Dir.chdir する)。相対パス `../releases/...` を deliver に
# 渡すと、ヘルパー内の Dir.exist? は fastlane/ 起点で通るのに、deliver は**アプリルート起点**で解決し
# 別ディレクトリを見に行く。deliver はそこに metadata が無くてもエラーにせず「0 件アップロード」して
# `finished successfully` を出すため、**無言で何も反映されない**。
#
# 実害 (2026-08-05 判明): vlc-multi-video-player で v1.1.0 以降の全リリースの metadata が
# 一度も ASC に反映されていなかった (apps/releases/ という誤った場所に空 dir が作られていた)。
# DualNoteApp でも apps/DualNoteApp/releases/ に同じ痕跡を確認。
def project_root
  root = File.expand_path("..", Dir.pwd)
  unless File.exist?(File.join(root, "project.yml"))
    raise "project root を特定できない (#{root} に project.yml が無い)。\n" \
          "fastlane が想定と違う cwd で動いている可能性がある。"
  end
  root
end

def current_marketing_version
  yml = File.read(File.join(project_root, "project.yml"))
  match = yml.match(/MARKETING_VERSION:\s*"([^"]+)"/)
  raise "MARKETING_VERSION not found in project.yml" unless match
  match[1]
end

# メタデータの置き場は 2 通りある。
#
# - **共有レイアウト (推奨)**: `releases/current/metadata/<locale>/` に説明文・キーワード等を
#   1 組だけ置き、バージョンごとに変わるリリースノートだけを
#   `releases/v<version>/release_notes/<locale>.txt` に置く。App Store Connect は説明文等について
#   「現在の値」しか持たないので、バージョンごとに複製すると古いディレクトリを編集する事故が起きる。
#   過去に何を出したかは git のタグ・履歴で辿る
# - **バージョンごとのレイアウト (旧来)**: `releases/v<version>/metadata/<locale>/` に
#   リリースノートを含む全項目を置く。`releases/current/metadata` が無いときはこちらを使う
#
# 共有レイアウトが在ればそちらを優先する (混在時に旧来を黙って使わない)。
def release_metadata_path
  v = current_marketing_version
  shared = File.join(project_root, "releases", "current", "metadata")
  return shared if Dir.exist?(shared)

  path = File.join(project_root, "releases", "v#{v}", "metadata")
  unless Dir.exist?(path)
    raise "Metadata directory not found: releases/current/metadata または releases/v#{v}/metadata\n" \
          "共有レイアウトなら releases/current/metadata を、バージョンごとのレイアウトなら\n" \
          "MARKETING_VERSION=#{v} に対応するディレクトリを用意してください\n" \
          "(旧来レイアウトの初期化: cp -r releases/vPREV/metadata releases/v#{v}/metadata)。"
  end
  path
end

# バージョン別のリリースノート (共有レイアウトで使う)。
#
# deliver は `options[key] ||= File.read(path)` の順で解決するため、ここで渡した値が
# metadata_path 配下の release_notes.txt より優先される。ディレクトリが無ければ nil を返し、
# 旧来レイアウトの metadata_path 配下 release_notes.txt がそのまま使われる。
def release_notes_by_locale
  v = current_marketing_version
  dir = File.join(project_root, "releases", "v#{v}", "release_notes")
  return nil unless Dir.exist?(dir)

  notes = Dir.glob(File.join(dir, "*.txt")).sort.to_h do |path|
    [File.basename(path, ".txt"), File.read(path)]
  end
  if notes.empty?
    raise "Release notes not found: releases/v#{v}/release_notes/<locale>.txt\n" \
          "ディレクトリは在るが .txt が 1 つも無い。そのまま upload すると\n" \
          "App Store Connect の「このバージョンの新機能」が前バージョンのまま残る。"
  end
  notes
end

# metadata を送る lane が共通で渡す引数 (バージョン別ノートが在れば release_notes を足す)。
def deliver_metadata_options
  options = {
    app_version: current_marketing_version,
    metadata_path: release_metadata_path
  }
  notes = release_notes_by_locale
  options[:release_notes] = notes if notes
  options
end

def release_screenshots_path
  v = current_marketing_version
  path = File.join(project_root, "releases", "v#{v}", "screenshots")
  # release_metadata_path と対称に fail-fast にする (auto-mkdir 禁止)。
  # 過去 `Dir.mkdir(path) unless Dir.exist?(path)` で silent に空 dir を
  # 作っていたが、cwd 違い / バージョン文字列ミスマッチでも errors out せず
  # 空 screenshots dir を作り、`deliver(overwrite_screenshots: true)` が
  # それを App Store screenshots の wipe upload と解釈する潜在事故を生む。
  unless Dir.exist?(path)
    raise "Screenshots directory not found: releases/v#{v}/screenshots\n" \
          "MARKETING_VERSION=#{v} に対応する screenshots ディレクトリが存在しない。\n" \
          "前バージョンから cp -r releases/vPREV/screenshots releases/v#{v}/screenshots で初期化してください。"
  end
  path
end

def app_bundle_id_from_appfile
  # fastlane は実行時に fastlane/ ディレクトリへ chdir するため Appfile は ./Appfile
  appfile = File.read("./Appfile")
  match = appfile.match(/app_identifier\s+["']([^"']+)["']/)
  raise "app_identifier not found in fastlane/Appfile" unless match
  match[1]
end

def availability_path
  "./available_territories.json"
end

# Apple ASC API の territoryAvailability resource id は
# urlsafe_base64({"s":"<app_id>","t":"<territory_code>"}) という規約。
# これを decode して territory code (ISO 3166 alpha-3) を取り出す。
def territory_code_from_resource_id(resource_id)
  decoded = Base64.urlsafe_decode64(resource_id)
  parsed = JSON.parse(decoded)
  parsed["t"]
rescue StandardError
  nil
end

# Spaceship::ConnectAPI のグローバルセッションを設定する。
# fastlane の deliver action は内部で同様の処理を行うが、
# 直接 Spaceship API を呼ぶ lane では明示的に session を作る必要がある。
def establish_asc_session
  require 'spaceship'
  api_key_json = JSON.parse(File.read("./api_key.json"))
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: api_key_json["key_id"],
    issuer_id: api_key_json["issuer_id"],
    key: api_key_json["key"]
  )
end

platform :mac do
  desc "メタデータのみアップロード（スクリーンショットなし）"
  lane :metadata do
    deliver(
      **deliver_metadata_options,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true
    )
  end

  desc "スクリーンショットのみアップロード"
  lane :screenshots do
    deliver(
      app_version: current_marketing_version,
      screenshots_path: release_screenshots_path,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "メタデータ + スクリーンショットをアップロード"
  lane :upload_metadata do
    deliver(
      **deliver_metadata_options,
      screenshots_path: release_screenshots_path,
      skip_binary_upload: true,
      force: true
    )
  end

  desc "ビルドをアップロード（審査には提出しない）"
  lane :upload_build do |options|
    pkg_path = options[:pkg] || ENV["PKG_PATH"] || Dir["../build/export/*.pkg"].first

    deliver(
      pkg: pkg_path,
      skip_binary_upload: false,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "全てアップロード（メタデータ + スクショ + ビルド）"
  lane :upload_all do |options|
    pkg_path = options[:pkg] || ENV["PKG_PATH"] || Dir["../build/export/*.pkg"].first

    deliver(
      **deliver_metadata_options,
      pkg: pkg_path,
      screenshots_path: release_screenshots_path,
      skip_binary_upload: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "審査に提出"
  lane :submit do
    deliver(
      app_version: current_marketing_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end

  desc "ASC の現在の配信対象 territory（app-level）を取得して表示"
  lane :availability_show do
    establish_asc_session

    bundle_id = app_bundle_id_from_appfile
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("App not found for bundle id #{bundle_id}") unless app

    # /v2/appAvailabilities/{id}/territoryAvailabilities を pagination で取得。
    # Apple は relationships endpoint を Spaceship に wrapper しないので raw HTTP。
    # resource id は base64({s: app_id, t: territory_code}) を decode する規約。
    client = Spaceship::ConnectAPI.token ? Spaceship::ConnectAPI : raise("No ASC session")
    url = "v2/appAvailabilities/#{app.id}/territoryAvailabilities?limit=50"
    territory_ids = []
    loop do
      resp = client.tunes_request_client.get(url)
      body = resp.body
      Array(body["data"]).each do |t|
        next unless t.dig("attributes", "available")
        code = territory_code_from_resource_id(t["id"])
        territory_ids << code if code
      end
      next_url = body.dig("links", "next")
      break unless next_url
      url = next_url.sub(%r{^https?://[^/]+/}, "")
    end
    territory_ids.sort!

    UI.message "Currently available in #{territory_ids.size} territories:"
    UI.message JSON.pretty_generate({ "territories" => territory_ids })
    UI.message ""
    UI.message "fastlane/available_territories.json を初期化するには上記 JSON を保存してください。"
  end

  desc "fastlane/available_territories.json を ASC に反映（territory_ids を更新）[WIP]"
  lane :availability_apply do
    # Apple ASC API の AppAvailability v2 は仕様変更が複数回入っており、
    # 単純な territory_ids のリスト patch では受け付けない:
    #   - 旧 Spaceship App#update(territory_ids:) → /v1/apps/{id}/availableTerritories
    #     関係が削除済み（404）
    #   - POST /v2/appAvailabilities → 既存 AppAvailability があるため 409
    #   - PATCH /v2/appAvailabilities/{id} は Apple サンプルが乏しく、
    #     全 territory resource を included に展開する必要があり仕様の
    #     詰め切りが必要
    #
    # 当面は availability_show で現状取得 + Web UI（App Store Connect）で
    # 配信対象を編集する運用を推奨。ローカル fastlane/available_territories.json は
    # 「現状の単一マスター」として保持し、apply 実装は spaceship 側の
    # メンテナンス追従を待つ。
    UI.user_error!(
      "availability_apply は WIP（Apple ASC API 仕様変更により未実装）。\n" \
      "現状: make asc-availability-show で取得 → Web UI で編集 →\n" \
      "      取得値を fastlane/available_territories.json に再保存して push、の運用。"
    )
  end
end

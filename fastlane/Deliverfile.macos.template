# Deliver 設定 (macOS)
# https://docs.fastlane.tools/actions/deliver/
#
# metadata_path / screenshots_path は Fastfile の各 lane が
# project.yml の MARKETING_VERSION から動的に解決するためここでは指定しない。

# App Store Connect API Key 認証（Apple ID / パスワードは使わない）
api_key_path "./fastlane/api_key.json"

# スクリーンショットを上書きする
overwrite_screenshots true

# 審査には自動提出しない
submit_for_review false

# プラットフォーム（macOS）
platform "osx"

# 確認プロンプトをスキップ
force true

# API Key では IAP チェックが動かないため無効化
run_precheck_before_submit false
